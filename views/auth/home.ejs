<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BioLab Diagnostics — Precise Results, Trusted Care</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&family=IBM+Plex+Sans+Arabic:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style/home.css">
</head>
<body>

<header>
  <div class="wrap nav">
    <div class="logo">
      <div class="logo-mark">⚗</div>
      <span>BIOLAB<small>DIAGNOSTICS</small></span>
    </div>
    <nav>
      <ul>
        <li><a href="/home" class="active">Home</a></li>
        <li><a href="/contactUs">Contact us</a></li>
        <li><a href="/AboutUs">About us</a></li>
        <li><a href="#tests">Tests</a></li>
        <li><a href="#results">Results</a></li>
      </ul>
    </nav>
    <button class="btn btn-primary">Book a Test</button>
  </div>
</header>

<main id="home">
  <!-- HERO -->
  <section class="hero" style="padding-bottom:0;">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Accredited lab, fast results</span>
        <h1>Precise Results,<br><em>Trusted Care</em></h1>
        <p>Book a test, follow a simple four-step process from sample to report, and read a new scientific insight every day.</p>
        <div class="hero-actions">
          <button class="btn btn-primary">Book a test</button>
          <button class="btn btn-ghost">View my results</button>
        </div>
      </div>
      <div class="hero-art">
        <svg viewBox="0 0 420 380" xmlns="http://www.w3.org/2000/svg">
          <circle cx="210" cy="190" r="170" fill="#DCE7F5"/>
          <circle cx="210" cy="190" r="130" fill="#FFFFFF" opacity="0.6"/>
          <g transform="translate(110,55)">
            <!-- test tube rack -->
            <rect x="0" y="150" width="200" height="16" rx="8" fill="#1B3B6F"/>
            <!-- tube 1 -->
            <rect x="18" y="40" width="26" height="120" rx="13" fill="#FFFFFF" stroke="#DCE7F5" stroke-width="3"/>
            <rect x="18" y="95" width="26" height="65" rx="13" fill="#4E8FE0"/>
            <!-- tube 2 -->
            <rect x="60" y="10" width="26" height="150" rx="13" fill="#FFFFFF" stroke="#DCE7F5" stroke-width="3"/>
            <rect x="60" y="80" width="26" height="80" rx="13" fill="#E86A4A"/>
            <!-- tube 3 -->
            <rect x="102" y="55" width="26" height="105" rx="13" fill="#FFFFFF" stroke="#DCE7F5" stroke-width="3"/>
            <rect x="102" y="100" width="26" height="60" rx="13" fill="#6C63C9"/>
            <!-- tube 4 -->
            <rect x="144" y="30" width="26" height="130" rx="13" fill="#FFFFFF" stroke="#DCE7F5" stroke-width="3"/>
            <rect x="144" y="90" width="26" height="70" rx="13" fill="#F2B84A"/>
            <!-- microscope silhouette -->
            <g transform="translate(60,-30)">
              <rect x="0" y="55" width="70" height="8" rx="4" fill="#1B3B6F"/>
              <rect x="28" y="20" width="14" height="40" rx="6" fill="#2C5FA8"/>
              <circle cx="35" cy="14" r="10" fill="#1B3B6F"/>
            </g>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <!-- BOOKING BAR -->
  <div class="wrap">
    <div class="booking-bar">
      <div class="field">
        <label>Test type</label>
        <select><option>Choose test</option><option>Blood panel</option><option>Urine analysis</option><option>Hormone panel</option><option>Allergy screening</option></select>
      </div>
      <div class="field">
        <label>Sample collection</label>
        <select><option>Choose option</option><option>At the lab</option><option>Home collection</option></select>
      </div>
      <div class="field">
        <label>Date</label>
        <input type="date">
      </div>
      <button class="btn btn-primary">Book now</button>
    </div>
  </div>

  <!-- Quick test panels -->
  <div class="wrap panels-strip">
    <div class="panels">
      <div class="panel"><div class="ico">🩸</div><h4>Blood Analysis</h4></div>
      <div class="panel"><div class="ico">🧫</div><h4>Microbiology</h4></div>
      <div class="panel"><div class="ico">🧬</div><h4>Genetic Testing</h4></div>
      <div class="panel"><div class="ico">🏠</div><h4>Home Collection</h4></div>
    </div>
  </div>

  <!-- STEPS -->
  <section class="steps-section">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">the process</span>
        <h2>Four steps to your results</h2>
        <p>From booking a test to reading your report online, BioLab keeps every step simple and transparent.</p>
      </div>
      <div class="steps-rail">
        <div class="step">
          <div class="step-num">01</div>
          <h3>Choose your test</h3>
          <p>Select from blood, urine, genetic, or specialized diagnostic panels.</p>
        </div>
        <div class="step">
          <div class="step-num">02</div>
          <h3>Book a collection</h3>
          <p>Visit the lab or request a certified nurse to collect your sample at home.</p>
        </div>
        <div class="step">
          <div class="step-num">03</div>
          <h3>Sample is analyzed</h3>
          <p>Your sample is processed in our accredited lab with strict quality control.</p>
        </div>
        <div class="step">
          <div class="step-num">04</div>
          <h3>Get your report</h3>
          <p>Access your results securely online, with a doctor's note when needed.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Results speed strip -->
  <div class="results-strip">
    <div class="wrap results-grid">
      <div><div class="num">98%</div><div class="lbl">Accuracy rate</div></div>
      <div><div class="num">24h</div><div class="lbl">Average turnaround</div></div>
      <div><div class="num">40+</div><div class="lbl">Test panels offered</div></div>
      <div><div class="num">12</div><div class="lbl">Collection centers</div></div>
    </div>
  </div>

  <!-- DAILY SCIENTIFIC ARTICLE -->
  <section class="article-section">
    <div class="wrap">
      <div class="section-head center" style="direction:rtl; text-align:center; margin-left:auto; margin-right:auto;">
        <span class="eyebrow" style="direction:ltr; justify-content:center;">daily read</span>
        <h2 style="font-family:'IBM Plex Sans Arabic', sans-serif;">المقالة العلمية</h2>
        <p style="font-family:'IBM Plex Sans Arabic', sans-serif;">مقال علمي جديد كل يوم حول التحاليل الطبية ومؤشرات الصحة، يختاره فريقنا المخبري ليساعدك على فهم نتائجك.</p>
      </div>

      <div class="article-card" id="articleCard">
        <div class="article-visual">
          <div>
            <span class="today-badge"><span class="dot"></span> يتحدّث يوميًا</span>
          </div>
          <div>
            <div class="cat" id="articleCat">تحاليل الدم</div>
            <div class="article-date" id="articleDate">— — —</div>
          </div>
        </div>
        <div class="article-body">
          <span class="article-tag" id="articleTag">مقال اليوم</span>
          <h3 id="articleTitle">عنوان المقال</h3>
          <p id="articleExcerpt">نص تمهيدي عن المقال...</p>
          <div class="article-meta">
            <span class="author" id="articleAuthor">بقلم —</span>
            <button class="btn btn-amber">اقرأ المقال كاملاً</button>
          </div>
        </div>
      </div>
      <p class="article-cycle-note">يتغيّر هذا المقال تلقائيًا كل يوم — عد غدًا لاكتشاف موضوع جديد.</p>
    </div>
  </section>
</main>

<footer>
  <div class="wrap foot-grid">
    <div class="logo">
      <div class="logo-mark">⚗</div>
      <span>BIOLAB<small style="color:rgba(255,255,255,0.7)">DIAGNOSTICS</small></span>
    </div>
    <div style="font-size:14px; opacity:0.85;">Home · Contact us · About us · Tests · Results</div>
  </div>
  <div class="wrap foot-copy">© 2026 BioLab Diagnostics. All rights reserved.</div>
</footer>

<script>
  // Daily-rotating scientific article — picks a different entry each calendar day
  const articles = [
    { cat:"تحاليل الدم", tag:"مقال اليوم", title:"كيف تقرأ نتائج تحليل الدم الروتيني؟",
      excerpt:"دليل مبسّط لفهم أهم المؤشرات في تحليل الدم الشامل، مثل كريات الدم الحمراء والبيضاء ونسبة السكر.",
      author:"د. حسام زروقي" },
    { cat:"علم الوراثة", tag:"مقال اليوم", title:"الفحص الجيني: متى يكون ضروريًا؟",
      excerpt:"نظرة على الحالات التي يُنصح فيها بإجراء تحاليل جينية، وما الذي يمكن أن تكشفه عن صحتك المستقبلية.",
      author:"د. إيمان قاسمي" },
    { cat:"علم الأحياء الدقيقة", tag:"مقال اليوم", title:"لماذا تتأخر بعض نتائج التحاليل المخبرية؟",
      excerpt:"شرح للخطوات العلمية التي تمر بها العينة داخل المخبر، من الاستلام إلى التحليل الدقيق.",
      author:"د. وليد حمّودي" },
    { cat:"صحة الغدد", tag:"مقال اليوم", title:"تحليل الهرمونات: ما الذي يخبرنا به عن أجسامنا؟",
      excerpt:"تعرف على العلاقة بين اضطرابات الغدة الدرقية وبعض الأعراض اليومية التي قد نتجاهلها.",
      author:"د. سلمى بوعزيز" },
    { cat:"تغذية", tag:"مقال اليوم", title:"نقص الفيتامينات: كيف يكتشفه التحليل المخبري؟",
      excerpt:"أبرز التحاليل التي تكشف نقص فيتامين د والحديد وفيتامين ب12، وأعراضها الشائعة.",
      author:"د. فريد بلعابد" },
    { cat:"أمراض مزمنة", tag:"مقال اليوم", title:"متابعة السكري عبر تحليل الهيموغلوبين السكري",
      excerpt:"لماذا يُعتبر هذا التحليل مرجعًا مهمًا لمرضى السكري لمتابعة مستوى السكر خلال الأشهر الماضية.",
      author:"د. رانيا مختاري" },
    { cat:"صحة عامة", tag:"مقال اليوم", title:"الفحوصات المخبرية الوقائية بعد سن الأربعين",
      excerpt:"قائمة بأهم التحاليل الدورية التي ينصح بها الأطباء للكشف المبكر عن الأمراض المزمنة.",
      author:"د. عبد الحق زيتوني" }
  ];

  const now = new Date();
  const dayIndex = Math.floor(now.getTime() / 86400000) % articles.length;
  const today = articles[dayIndex];

  document.getElementById('articleCat').textContent = today.cat;
  document.getElementById('articleTag').textContent = today.tag;
  document.getElementById('articleTitle').textContent = today.title;
  document.getElementById('articleExcerpt').textContent = today.excerpt;
  document.getElementById('articleAuthor').textContent = "بقلم " + today.author;
  document.getElementById('articleDate').textContent = now.toLocaleDateString('ar-DZ', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
</script>

</body>
</html>