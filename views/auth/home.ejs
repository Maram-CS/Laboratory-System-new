<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BioLab Diagnostics — Precise Results, Trusted Care</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&family=IBM+Plex+Sans+Arabic:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../style/home.css">
</head>
<body>

<header>
  <div class="wrap nav">
    <div class="logo">
      <div class="logo-mark">⚗</div>
      <span>BIOLAB<small>DIAGNOSTICS</small></span>
    </div>
    <nav>
      <ul>
        <li><a href="/home" class="active">Home</a></li>
        <li><a href="/contactUs">Contact us</a></li>
        <li><a href="/aboutUs">About us</a></li>
        <li><a href="#tests">Tests</a></li>
        <li><a href="#track">Results</a></li>
      </ul>
    </nav>
    <button class="btn btn-primary">Book a Test</button>
  </div>
</header>

<main id="home">
  <!-- HERO مع خلفية مصورة -->
<section class="hero" style="padding-bottom:0; background-image: url('https://images.unsplash.com/photo-1579684385127-1ef15d508118?w=1400&q=80'); background-size: cover; background-position: center; position: relative; min-height: 520px;">
  
  <!-- التراكب الداكن -->
  <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(27,59,111,0.80) 0%, rgba(27,59,111,0.35) 100%); z-index: 1;"></div>
  
  <div class="wrap hero-grid" style="position: relative; z-index: 2; padding: 50px 0 70px;">
    
    <!-- النص -->
    <div style="color: white;">
      <span class="eyebrow" style="color: rgba(255,255,255,0.7);">Accredited Lab · Fast Results</span>
      <h1 style="color: white; font-size: 52px; line-height: 1.1;">Your Health,<br><em style="color: #F2B84A; font-style: normal;">Our Priority</em></h1>
      <p style="color: rgba(255,255,255,0.85); font-size: 17px; max-width: 460px; line-height: 1.7; margin-top: 18px;">
        Compassionate care for you and your family. Book a test and get accurate results from our accredited laboratory.
      </p>
      <div class="hero-actions" style="margin-top: 28px;">
        <button class="btn btn-primary" style="background: #F2B84A; color: #1B3B6F; box-shadow: 0 8px 24px -8px rgba(242,184,74,0.5); border: none; padding: 14px 32px; border-radius: 100px; font-weight: 700; font-size: 15px; cursor: pointer;">Book Appointment</button>
        <button class="btn" style="background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 1.5px solid rgba(255,255,255,0.25); color: white; border-radius: 100px; padding: 14px 28px; font-weight: 600; font-size: 14px; cursor: pointer;">View Services</button>
      </div>
    </div>
    
    <!-- lphoto sghira -->
    <div style="display: flex; justify-content: center; align-items: center;">
      <div style="background: rgba(255,255,255,0.06); border-radius: 24px; padding: 16px; backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.08);">
        <img src="https://images.unsplash.com/photo-1586773860418-d37222d8fce3?w=400&q=80" alt="Medical laboratory" style="border-radius: 16px; width: 100%; max-width: 360px; display: block;">
      </div>
    </div>
    
  </div>
</section>
  <!-- BOOKING BAR -->
  <div class="wrap">
    <div class="booking-bar">
      <div class="field">
        <label>Test type</label>
        <select><option>Choose test</option><option>Blood panel</option><option>Urine analysis</option><option>Hormone panel</option><option>Allergy screening</option></select>
      </div>
      <div class="field">
        <label>Sample collection</label>
        <select><option>Choose option</option><option>At the lab</option><option>Home collection</option></select>
      </div>
      <div class="field">
        <label>Date</label>
        <input type="date">
      </div>
      <button class="btn btn-primary">Book now</button>
    </div>
  </div>

  <!-- Quick test panels -->
  <div class="wrap panels-strip">
    <div class="panels">
      <div class="panel">
        <div class="ico">🩸</div>
        <h4>Blood Analysis</h4>
        <p class="detail">Results in ~6h · venous draw</p>
      </div>
      <div class="panel">
        <div class="ico">🧫</div>
        <h4>Microbiology</h4>
        <p class="detail">Results in 24–72h · culture-based</p>
      </div>
      <div class="panel">
        <div class="ico">🧬</div>
        <h4>Genetic Testing</h4>
        <p class="detail">Results in 5–10 days · saliva or blood</p>
      </div>
      <div class="panel">
        <div class="ico">🏠</div>
        <h4>Home Collection</h4>
        <p class="detail">Nurse arrives within 2h slot</p>
      </div>
    </div>
  </div>

  <!-- ACCREDITATION STRIP -->
  <div class="accred-strip">
    <div class="wrap accred-row">
      <span>ISO 15189:2022 ACCREDITED</span>
      <span class="dash">/</span>
      <span>MINISTRY OF HEALTH LICENSED</span>
      <span class="dash">/</span>
      <span>EXTERNAL QUALITY ASSURANCE PARTICIPANT</span>
      <span class="dash">/</span>
      <span>UNBROKEN SAMPLE CHAIN OF CUSTODY</span>
    </div>
  </div>

  <!-- STEPS -->
  <section class="steps-section">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">the process</span>
        <h2>Four steps to your results</h2>
        <p>From booking a test to reading your report online, BioLab keeps every step simple and transparent.</p>
      </div>
      <div class="steps-rail">
        <div class="step">
          <div class="step-num">01</div>
          <h3>Choose your test</h3>
          <p>Select from blood, urine, genetic, or specialized diagnostic panels.</p>
        </div>
        <div class="step">
          <div class="step-num">02</div>
          <h3>Book a collection</h3>
          <p>Visit the lab or request a certified nurse to collect your sample at home.</p>
        </div>
        <div class="step">
          <div class="step-num">03</div>
          <h3>Sample is analyzed</h3>
          <p>Your sample is processed in our accredited lab with strict quality control.</p>
        </div>
        <div class="step">
          <div class="step-num">04</div>
          <h3>Get your report</h3>
          <p>Access your results securely online, with a doctor's note when needed.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- LIVE SAMPLE TRACKER (signature element) -->
  <section class="tracker-section" id="track">
    <div class="wrap tracker-grid">
      <div class="tracker-copy">
        <span class="eyebrow" style="color:rgba(255,255,255,.65);">live status</span>
        <h2>Where's my sample?</h2>
        <p>Enter the order number from your receipt to follow it through every stage of analysis, updated in real time.</p>
        <div class="tracker-input-row">
          <input type="text" id="trackInput" placeholder="e.g. BL-240815" maxlength="14" autocomplete="off">
          <button class="btn btn-amber" id="trackBtn" type="button">Track</button>
        </div>
        <p class="tracker-hint" id="trackHint">This is a live preview of the tracker — try any order number.</p>
      </div>

      <div class="tracker-monitor" id="trackerMonitor" aria-live="polite">
        <div class="monitor-line" id="monitorLine"></div>
        <div class="stage" data-stage="1">
          <div class="stage-dot"></div>
          <span class="stage-label">Received</span>
          <span class="stage-time">—</span>
        </div>
        <div class="stage" data-stage="2">
          <div class="stage-dot"></div>
          <span class="stage-label">Processing</span>
          <span class="stage-time">—</span>
        </div>
        <div class="stage" data-stage="3">
          <div class="stage-dot"></div>
          <span class="stage-label">Verified</span>
          <span class="stage-time">—</span>
        </div>
        <div class="stage" data-stage="4">
          <div class="stage-dot"></div>
          <span class="stage-label">Ready</span>
          <span class="stage-time">—</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Results speed strip -->
  <div class="results-strip">
    <div class="wrap results-grid">
      <div><div class="num" data-target="98" data-suffix="%">0%</div><div class="lbl">Accuracy rate</div></div>
      <div><div class="num" data-target="24" data-suffix="h">0h</div><div class="lbl">Average turnaround</div></div>
      <div><div class="num" data-target="40" data-suffix="+">0+</div><div class="lbl">Test panels offered</div></div>
      <div><div class="num" data-target="12" data-suffix="">0</div><div class="lbl">Collection centers</div></div>
    </div>
  </div>

  <!-- DAILY SCIENTIFIC ARTICLE -->
  <section class="article-section">
    <div class="wrap">
      <div class="section-head center" style="direction:rtl; text-align:center; margin-left:auto; margin-right:auto;">
        <span class="eyebrow" style="direction:ltr; justify-content:center;">daily read</span>
        <h2 style="font-family:'IBM Plex Sans Arabic', sans-serif;">المقالة العلمية</h2>
        <p style="font-family:'IBM Plex Sans Arabic', sans-serif;">مقال علمي جديد كل يوم حول التحاليل الطبية ومؤشرات الصحة، يختاره فريقنا المخبري ليساعدك على فهم نتائجك.</p>
      </div>

      <div class="article-card" id="articleCard">
        <div class="article-visual">
          <div>
            <span class="today-badge"><span class="dot"></span> يتحدّث يوميًا</span>
          </div>
          <div>
            <div class="cat" id="articleCat">تحاليل الدم</div>
            <div class="article-date" id="articleDate">— — —</div>
          </div>
        </div>
        <div class="article-body">
          <span class="article-tag" id="articleTag">مقال اليوم</span>
          <h3 id="articleTitle">عنوان المقال</h3>
          <p id="articleExcerpt">نص تمهيدي عن المقال...</p>
          <div class="article-meta">
            <span class="author" id="articleAuthor">بقلم —</span>
            <button class="btn btn-amber">اقرأ المقال كاملاً</button>
          </div>
        </div>
      </div>
      <p class="article-cycle-note">يتغيّر هذا المقال تلقائيًا كل يوم — عد غدًا لاكتشاف موضوع جديد.</p>
    </div>
  </section>
</main>

<footer>
  <div class="wrap foot-grid">
    <div class="logo">
      <div class="logo-mark">⚗</div>
      <span>BIOLAB<small style="color:rgba(255,255,255,0.7)">DIAGNOSTICS</small></span>
    </div>
    <div style="font-size:14px; opacity:0.85;">Home · Contact us · About us · Tests · Results</div>
  </div>
  <div class="wrap foot-copy">© 2026 BioLab Diagnostics. All rights reserved.</div>
</footer>

<script>
  // Daily-rotating scientific article — picks a different entry each calendar day
  const articles = [
    { cat:"تحاليل الدم", tag:"مقال اليوم", title:"كيف تقرأ نتائج تحليل الدم الروتيني؟",
      excerpt:"دليل مبسّط لفهم أهم المؤشرات في تحليل الدم الشامل، مثل كريات الدم الحمراء والبيضاء ونسبة السكر.",
      author:"د. حسام زروقي" },
    { cat:"علم الوراثة", tag:"مقال اليوم", title:"الفحص الجيني: متى يكون ضروريًا؟",
      excerpt:"نظرة على الحالات التي يُنصح فيها بإجراء تحاليل جينية، وما الذي يمكن أن تكشفه عن صحتك المستقبلية.",
      author:"د. إيمان قاسمي" },
    { cat:"علم الأحياء الدقيقة", tag:"مقال اليوم", title:"لماذا تتأخر بعض نتائج التحاليل المخبرية؟",
      excerpt:"شرح للخطوات العلمية التي تمر بها العينة داخل المخبر، من الاستلام إلى التحليل الدقيق.",
      author:"د. وليد حمّودي" },
    { cat:"صحة الغدد", tag:"مقال اليوم", title:"تحليل الهرمونات: ما الذي يخبرنا به عن أجسامنا؟",
      excerpt:"تعرف على العلاقة بين اضطرابات الغدة الدرقية وبعض الأعراض اليومية التي قد نتجاهلها.",
      author:"د. سلمى بوعزيز" },
    { cat:"تغذية", tag:"مقال اليوم", title:"نقص الفيتامينات: كيف يكتشفه التحليل المخبري؟",
      excerpt:"أبرز التحاليل التي تكشف نقص فيتامين د والحديد وفيتامين ب12، وأعراضها الشائعة.",
      author:"د. فريد بلعابد" },
    { cat:"أمراض مزمنة", tag:"مقال اليوم", title:"متابعة السكري عبر تحليل الهيموغلوبين السكري",
      excerpt:"لماذا يُعتبر هذا التحليل مرجعًا مهمًا لمرضى السكري لمتابعة مستوى السكر خلال الأشهر الماضية.",
      author:"د. رانيا مختاري" },
    { cat:"صحة عامة", tag:"مقال اليوم", title:"الفحوصات المخبرية الوقائية بعد سن الأربعين",
      excerpt:"قائمة بأهم التحاليل الدورية التي ينصح بها الأطباء للكشف المبكر عن الأمراض المزمنة.",
      author:"د. عبد الحق زيتوني" }
  ];

  const now = new Date();
  const dayIndex = Math.floor(now.getTime() / 86400000) % articles.length;
  const today = articles[dayIndex];

  document.getElementById('articleCat').textContent = today.cat;
  document.getElementById('articleTag').textContent = today.tag;
  document.getElementById('articleTitle').textContent = today.title;
  document.getElementById('articleExcerpt').textContent = today.excerpt;
  document.getElementById('articleAuthor').textContent = "بقلم " + today.author;
  document.getElementById('articleDate').textContent = now.toLocaleDateString('ar-DZ', { weekday:'long', year:'numeric', month:'long', day:'numeric' });

  // ---------- Animated result counters ----------
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll('.results-grid .num');

  function animateCount(el){
    const target = parseInt(el.dataset.target, 10);
    const suffix = el.dataset.suffix || '';
    if(reduceMotion){ el.textContent = target + suffix; return; }
    const duration = 1100;
    const start = performance.now();
    function tick(now){
      const p = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(eased * target) + suffix;
      if(p < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  if('IntersectionObserver' in window){
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if(entry.isIntersecting){
          animateCount(entry.target);
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });
    nums.forEach(n => obs.observe(n));
  } else {
    nums.forEach(animateCount);
  }

  // ---------- Live sample tracker (demo) ----------
  const trackBtn = document.getElementById('trackBtn');
  const trackInput = document.getElementById('trackInput');
  const trackHint = document.getElementById('trackHint');
  const monitor = document.getElementById('trackerMonitor');
  const stages = Array.from(monitor.querySelectorAll('.stage'));
  const monitorLine = document.getElementById('monitorLine');
  let tracking = false;

  function resetStages(){
    stages.forEach(s => s.classList.remove('active','done'));
    stages.forEach(s => s.querySelector('.stage-time').textContent = '—');
    monitorLine.style.width = '0%';
  }

  function runTracking(){
    if(tracking) return;
    const value = trackInput.value.trim();
    if(!value){
      trackHint.textContent = 'Enter an order number first — e.g. BL-240815.';
      trackInput.focus();
      return;
    }
    tracking = true;
    resetStages();
    trackHint.textContent = 'Tracking order ' + value.toUpperCase() + ' …';
    trackBtn.disabled = true;

    const stepDelay = reduceMotion ? 0 : 700;
    const timeStamps = ['08:12', '09:40', '13:05', '15:30'];

    stages.forEach((stage, i) => {
      setTimeout(() => {
        stages.forEach(s => s.classList.remove('active'));
        if(i > 0) stages[i-1].classList.add('done');
        stage.classList.add('active');
        stage.querySelector('.stage-time').textContent = timeStamps[i];
        monitorLine.style.width = (i / (stages.length - 1) * 100) + '%';

        if(i === stages.length - 1){
          setTimeout(() => {
            stage.classList.remove('active');
            stage.classList.add('done');
            trackHint.textContent = 'Your report for ' + value.toUpperCase() + ' is ready.';
            trackBtn.disabled = false;
            tracking = false;
          }, stepDelay + 300);
        }
      }, i * (stepDelay + 300));
    });
  }

  trackBtn.addEventListener('click', runTracking);
  trackInput.addEventListener('keydown', (e) => { if(e.key === 'Enter') runTracking(); });
</script>

</body>
</html>