  <!-- TESTIMONIALS SLIDER -->
  <section class="testi-section">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">patient voices</span>
        <h2>What people say about BioLab</h2>
      </div>
      <div class="testi-wrap" id="testiWrap">
        <div class="testi-slide active">
          <p class="testi-quote">Results came back in under a day, and the report actually explained what each number meant.</p>
          <div class="testi-person">— Amina R., Sétif</div>
        </div>
        <div class="testi-slide">
          <p class="testi-quote">The home collection service saved me a trip with my newborn. The nurse was gentle and quick.</p>
          <div class="testi-person">— Karim B., Constantine</div>
        </div>
        <div class="testi-slide">
          <p class="testi-quote">I've used three different labs over the years — BioLab is the first one that felt like they cared.</p>
          <div class="testi-person">— Nour H., Sétif</div>
        </div>
      </div>
      <div class="testi-dots" id="testiDots"></div>
    </div>
  </section>

  <!-- FIND US / MAP -->
