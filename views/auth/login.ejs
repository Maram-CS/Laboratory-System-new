<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Log in — BioLab Diagnostics</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../style/home.css">
<link rel="stylesheet" href="../style/signUp.css">
<link rel="stylesheet" href="../style/login.css">
</head>
<body>

<header>
  <div class="wrap nav">
    <div class="logo">
      <div class="logo-mark">⚗</div>
      <span>BIOLAB<small>DIAGNOSTICS</small></span>
    </div>
    <nav>
      <ul>
        <li><a href="/home">Home</a></li>
        <li><a href="/contactUs">Contact us</a></li>
        <li><a href="/aboutUs">About us</a></li>
        <li><a href="/home#tests">Tests</a></li>
        <li><a href="/home#track">Results</a></li>
      </ul>
    </nav>
    <button class="btn btn-primary" type="button">Book a Test</button>
  </div>
</header>

<main>
  <section class="su-section">
    <div class="wrap">
      <div class="su-card">

        <aside class="su-aside">
          <div>
            <span class="eyebrow">Patient account</span>
            <h2>Welcome back</h2>
            <p>Log in to read your reports, follow your samples and book your next test.</p>
          </div>
          <ul class="su-perks">
            <li>Your reports stay private and secure</li>
            <li>See where your sample is in real time</li>
            <li>Rebook a test in a few clicks</li>
          </ul>
        </aside>

        <div class="su-form-wrap">
          <h1>Log in</h1>
          <p class="su-sub">New to BioLab? <a href="/register">Create an account</a></p>

          <form id="loginForm" method="POST" action="/users/login" novalidate>
            <div class="su-grid">
              <div class="field full">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" autocomplete="email" required>
                <span class="su-err">Enter a valid email address.</span>
              </div>
              <div class="field full">
                <label for="password">Password</label>
                <div class="su-pass">
                  <input type="password" id="password" name="password" autocomplete="current-password" required>
                  <button class="su-toggle" type="button" data-target="password">Show</button>
                </div>
                <span class="su-err">Enter your password.</span>
              </div>
              <div class="lg-row full">
                <label class="su-check" for="remember">
                  <input type="checkbox" id="remember" name="remember">
                  <span>Keep me logged in</span>
                </label>
                <a href="/forgotPassword">Forgot password?</a>
              </div>
            </div>
            <button class="btn btn-primary su-submit" type="submit">Log in</button>
          </form>
        </div>

      </div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap foot-grid">
    <div class="logo">
      <div class="logo-mark">⚗</div>
      <span>BIOLAB<small style="color:rgba(255,255,255,0.7)">DIAGNOSTICS</small></span>
    </div>
    <div style="font-size:14px; opacity:0.85;">Home · Contact us · About us · Tests · Results</div>
  </div>
  <div class="wrap foot-copy">© 2026 BioLab Diagnostics. All rights reserved.</div>
</footer>

<script>
  const form = document.getElementById('loginForm');

  document.querySelectorAll('.su-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const input = document.getElementById(btn.dataset.target);
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.textContent = show ? 'Hide' : 'Show';
    });
  });

  function setInvalid(input, bad) {
    input.closest('.field').classList.toggle('invalid', bad);
    return !bad;
  }

  form.addEventListener('submit', (e) => {
    const f = form.elements;
    const ok = [
      setInvalid(f.email, !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(f.email.value.trim())),
      setInvalid(f.password, !f.password.value)
    ].every(Boolean);
    if (!ok) {
      e.preventDefault();
      form.querySelector('.invalid input').focus();
    }
    // If valid, the form is posted to /login (handle it in Express)
  });
</script>

</body>
</html>
